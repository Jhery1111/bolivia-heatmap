# =============================================================================
# .env.example — Variables de entorno del motor ETL SIGMAC/DNTT
#
# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear .env al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos principal — PostgreSQL + PostGIS
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<base_de_datos>
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://sigmac:CHANGE_ME@localhost:5432/sigmac

# -----------------------------------------------------------------------------
# Redis — broker de colas y pub/sub en tiempo real
# Formato: redis://[:<contraseña>@]<host>:<puerto>/<db_index>
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Parámetros de procesamiento
# -----------------------------------------------------------------------------

# Número máximo de registros por lote de inserción masiva (1 - 10000)
BATCH_SIZE=500

# Intervalo en segundos entre ciclos de sincronización (mínimo: 5)
SYNC_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# Sistema JÚPITER (fuente externa legada)
# -----------------------------------------------------------------------------

# URL base de la API REST de JÚPITER
JUPITER_API_URL=http://jupiter.internal/api/v1

# API key de autenticación para JÚPITER
JUPITER_API_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# Sistema MINERVA (fuente externa — API REST paginada)
# DSN de la base de datos de MINERVA (usado como fallback si la API no está disponible)
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<base_de_datos>
# -----------------------------------------------------------------------------
MINERVA_DB_URL=postgresql://minerva:CHANGE_ME@minerva-db:5432/minerva

# -----------------------------------------------------------------------------
# Logging
# Valores permitidos: DEBUG | INFO | WARNING | ERROR | CRITICAL
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
