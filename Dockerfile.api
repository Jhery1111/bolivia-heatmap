# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc g++ \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY api/requirements.txt        /build/api-req.txt
COPY etl/requirements.txt        /build/etl-req.txt
COPY analytics/requirements.txt  /build/analytics-req.txt

# Instalar dependencias en etapas para mejor resiliencia ante timeouts
# --timeout 300: 5 minutos por paquete (numba/scipy son grandes)
RUN pip install --no-cache-dir --timeout 300 --prefix=/install \
    -r /build/api-req.txt
RUN pip install --no-cache-dir --timeout 300 --prefix=/install \
    -r /build/etl-req.txt
RUN pip install --no-cache-dir --timeout 300 --prefix=/install \
    -r /build/analytics-req.txt

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim

# libpq5 para psycopg2 — shapely/pyproj 2.x+ traen GEOS/PROJ bundled
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copiar paquetes compilados del builder
COPY --from=builder /install /usr/local

WORKDIR /app

COPY api/       ./api/
COPY etl/       ./etl/
COPY analytics/ ./analytics/

RUN useradd --no-create-home --shell /sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "api.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "2", \
     "--loop", "uvloop"]
