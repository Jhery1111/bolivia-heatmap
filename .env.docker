# ─────────────────────────────────────────────────────────────────────────────
#  SIGMAC — Variables de entorno para Docker local
#  Copia este archivo a .env.docker y ajusta según tu entorno.
#  NUNCA comitees este archivo con credenciales reales.
# ─────────────────────────────────────────────────────────────────────────────

# JWT — cambia SECRET_KEY en producción con:
#   openssl rand -hex 32
SECRET_KEY=local-dev-secret-do-not-use-in-production-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — orígenes permitidos (JSON array)
ALLOWED_ORIGINS=["http://localhost","http://localhost:80","http://127.0.0.1"]

# Logging
LOG_LEVEL=INFO

# ETL
BATCH_SIZE=500
SYNC_INTERVAL_SECONDS=30

# Sistemas externos (opcional en dev — los extractores usan simulación si están vacíos)
JUPITER_API_URL=
JUPITER_API_KEY=
MINERVA_DB_URL=
