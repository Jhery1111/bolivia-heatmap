[Unit]
Description=SIGMAC Queue Processor — Redis task consumer
Documentation=https://github.com/dntt-bolivia/sigmac
After=network.target network-online.target redis.service postgresql.service
Requires=redis.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sigmac
Group=sigmac
WorkingDirectory=/opt/sigmac
EnvironmentFile=/opt/sigmac/.env

ExecStart=/opt/sigmac/venv/bin/python -m etl.queue_processor

Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sigmac-queue

# ── Hardening ─────────────────────────────────────────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @reboot @swap @privileged @cpu-emulation @obsolete

# Rutas permitidas de escritura
ReadWritePaths=/opt/sigmac /tmp /var/log/sigmac

# Capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# Limits de recursos
LimitNOFILE=32768
LimitNPROC=256
TasksMax=256

[Install]
WantedBy=multi-user.target
