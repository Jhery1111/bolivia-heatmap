# =============================================================================
# SIGMAC API — Environment Variables
# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# -----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://sigmac:change_me@localhost:5432/sigmac

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Format: redis://[:PASSWORD@]HOST:PORT/DB_INDEX
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY=replace_with_openssl_rand_hex_32_output

# JWT signing algorithm — do not change unless you know what you are doing.
ALGORITHM=HS256

# Token expiry in minutes (default 480 = 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# CORS — Allowed Origins
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Example for development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Example for production (replace with real domain):
# ALLOWED_ORIGINS=https://sigmac.dntt.gob.bo,https://mapa.dntt.gob.bo

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
API_V1_PREFIX=/api/v1

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
